<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- -windows because it ProjectReferences the WPF app. The tests themselves need no display, no STA and no
         elevation: they only touch private *static* members, which never construct a Window. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Used by InvariantTests to PARSE the app's source. Regex/line-scanning was measured to be unreliable on this
         codebase (interpolated strings with nested quotes desync brace counters; positional SetBusy(true, ...) calls
         are missed by a named-argument grep). 4.14.0, not 5.x: the 5.x reference would break builds on a .NET 9 SDK. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DriveForge.csproj" />
  </ItemGroup>

  <!-- The source-scanning tests must locate the repo without hardcoding an absolute path. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
